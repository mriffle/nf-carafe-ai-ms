/*
 * Variable-modification parameters for the Carafe modifications stub test.
 *
 * Boolean params must be set via a config file (real Groovy booleans). They
 * cannot be passed reliably on the command line: Nextflow stores `--flag true`
 * as the string "true", which nf-schema rejects as a type mismatch (and a
 * string "false" is truthy in Groovy, so CLI booleans are unsafe regardless).
 */
params {
    include_phosphorylation     = true
    include_oxidized_methionine = true
}
